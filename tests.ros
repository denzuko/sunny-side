#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -- $0 "$@"
|#
(progn
  (ros:ensure-asdf))

(let ((root (uiop:pathname-directory-pathname *load-pathname*)))
  (push root asdf:*central-registry*))

(ql:quickload :sunny-side/tests :verbose nil)

(defun main (&rest argv)
  "Runs sunny-side's own smoke-test suite and exits 0 on success, 1
on failure."
  (declare (ignorable argv))
  (uiop:quit (if (sunny-side/tests:run-tests) 0 1)))
